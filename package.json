{
  "name": "velto-todo-workspace",
  "private": true,
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "python backend/manage.py test planner",
    "backend:install": "python -m pip install -r backend/requirements.txt",
    "backend:check": "python backend/manage.py check",
    "backend:migrate": "python backend/manage.py migrate",
    "backend:run": "python backend/manage.py runserver 127.0.0.1:8000"
  }
}
